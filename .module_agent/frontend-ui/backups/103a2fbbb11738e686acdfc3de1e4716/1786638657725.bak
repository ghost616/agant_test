import { describe, it, expect, vi, beforeEach, beforeAll } from 'vitest';
import { readFileSync } from 'fs';
import { resolve } from 'path';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import type { SessionMessage } from '../../../types/session';

const mocks = vi.hoisted(() => ({
  getSession: vi.fn(),
  getSessionMessagesRange: vi.fn(),
  getMemoryPrompt: vi.fn(),
  saveMemoryPrompt: vi.fn(),
  updateMemoryDocument: vi.fn(),
  regenerateMemory: vi.fn(),
  getRegenerateStatus: vi.fn(),
  listModels: vi.fn(),
}));
const mockNavigate = vi.hoisted(() => vi.fn());

let params: { sessionId?: string; type?: string; seqRange?: string } = {
  sessionId: '100',
  type: 'DAILY',
  seqRange: '1-3',
};
let locationState: Record<string, unknown> | null = {
  startSeq: 1,
  endSeq: 3,
  aggregationText: '聚合文本内容',
};

vi.mock('react-router-dom', () => ({
  useNavigate: () => mockNavigate,
  useParams: () => params,
  useLocation: () => ({ state: locationState }),
}));

vi.mock('../../../services/session', () => ({
  getSession: (...args: unknown[]) => mocks.getSession(...args),
  getSessionMessagesRange: (...args: unknown[]) => mocks.getSessionMessagesRange(...args),
}));

vi.mock('../../../services/memory', () => ({
  getMemoryPrompt: (...args: unknown[]) => mocks.getMemoryPrompt(...args),
  saveMemoryPrompt: (...args: unknown[]) => mocks.saveMemoryPrompt(...args),
  updateMemoryDocument: (...args: unknown[]) => mocks.updateMemoryDocument(...args),
  regenerateMemory: (...args: unknown[]) => mocks.regenerateMemory(...args),
  getRegenerateStatus: (...args: unknown[]) => mocks.getRegenerateStatus(...args),
}));

vi.mock('../../../services/model', () => ({
  listModels: (...args: unknown[]) => mocks.listModels(...args),
}));

import MemoryDocumentDetail from '../MemoryDocumentDetail';

beforeAll(() => {
  window.matchMedia =
    window.matchMedia ||
    ((query: string) => ({
      matches: false,
      media: query,
      onchange: null,
      addListener: vi.fn(),
      removeListener: vi.fn(),
      addEventListener: vi.fn(),
      removeEventListener: vi.fn(),
      dispatchEvent: vi.fn(),
    }));
});

function makeMessage(overrides: Partial<SessionMessage> = {}): SessionMessage {
  return {
    id: 'm1',
    sessionId: '100',
    role: 'user',
    content: '你好',
    sequenceNum: 1,
    createTime: '2026-08-01 09:00:00',
    ...overrides,
  };
}

function renderComponent() {
  return render(<MemoryDocumentDetail />);
}

describe('MemoryDocumentDetail 消息加载', () => {
  beforeEach(() => {
    mocks.getSessionMessagesRange.mockReset();
    mocks.getMemoryPrompt.mockReset();
    mocks.saveMemoryPrompt.mockReset();
    mocks.updateMemoryDocument.mockReset();
    mocks.regenerateMemory.mockReset();
    mocks.getRegenerateStatus.mockReset();
    mocks.listModels.mockReset();
    mockNavigate.mockReset();
    params = { sessionId: '100', type: 'DAILY', seqRange: '1-3' };
    locationState = { startSeq: 1, endSeq: 3, aggregationText: '聚合文本内容' };
  });

  it('根据路由 state 中的 startSeq/endSeq 调用 getSessionMessagesRange', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalledWith('100', 1, 3);
    });
  });

  it('state 缺失时从 seqRange 路由参数解析 startSeq/endSeq', async () => {
    locationState = null;
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalledWith('100', 1, 3);
    });
  });

  it('state 缺失时聚合文本显示为空占位', async () => {
    locationState = null;
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });
    expect(screen.getByText('暂无聚合文本')).toBeTruthy();
  });

  it('API 失败时提示错误并清空消息列表', async () => {
    mocks.getSessionMessagesRange.mockRejectedValue(new Error('Network Error'));
    renderComponent();
    await waitFor(() => {
      expect(screen.getByText('获取消息列表失败')).toBeTruthy();
    });
  });
});

describe('MemoryDocumentDetail 渲染', () => {
  beforeEach(() => {
    mocks.getSessionMessagesRange.mockReset();
    mocks.getMemoryPrompt.mockReset();
    mocks.saveMemoryPrompt.mockReset();
    mocks.updateMemoryDocument.mockReset();
    mocks.regenerateMemory.mockReset();
    mocks.getRegenerateStatus.mockReset();
    mocks.listModels.mockReset();
    mockNavigate.mockReset();
    params = { sessionId: '100', type: 'DAILY', seqRange: '1-3' };
    locationState = { startSeq: 1, endSeq: 3, aggregationText: '聚合文本内容' };
  });

  it('左侧 Markdown 展示聚合文本，右侧展示消息角色标签', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({ id: 'm1', role: 'user', content: '你好', sequenceNum: 1 }),
      makeMessage({
        id: 'm2',
        role: 'assistant',
        content: '收到',
        sequenceNum: 2,
        createTime: '2026-08-01 09:00:01',
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('聚合文本内容')).toBeTruthy();
    });

    await waitFor(() => {
      expect(screen.getByText('你')).toBeTruthy();
      expect(screen.getByText('助手')).toBeTruthy();
      expect(screen.getByText('你好')).toBeTruthy();
      expect(screen.getByText('收到')).toBeTruthy();
    });
  });

  it('消息按 sequenceNum 升序排列渲染（乱序输入仍按序输出）', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({ id: 'm3', role: 'assistant', content: '第三条', sequenceNum: 3 }),
      makeMessage({ id: 'm1', role: 'user', content: '第一条', sequenceNum: 1 }),
      makeMessage({ id: 'm2', role: 'assistant', content: '第二条', sequenceNum: 2 }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('第一条')).toBeTruthy();
    });

    const bubbles = Array.from(document.querySelectorAll('.agent-chat-markdown')).filter(
      (b) => (b.textContent ?? '').trim() !== '聚合文本内容',
    );
    const texts = bubbles.map((b) => b.textContent ?? '');
    expect(texts).toEqual(['第一条', '第二条', '第三条']);
  });

  it('助手消息有 reasoning 时显示"思考过程"块（黄色左边框）', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({
        id: 'm1',
        role: 'assistant',
        content: '总结',
        reasoning: '思考中...',
        sequenceNum: 1,
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('思考过程')).toBeTruthy();
    });
    expect(screen.getByText('思考中...')).toBeTruthy();
    expect(screen.getByText('总结')).toBeTruthy();

    const reasoningBlock = Array.from(
      document.querySelectorAll('.agent-chat-markdown'),
    ).find((b) => b.textContent?.includes('思考过程'));
    expect(reasoningBlock).toBeTruthy();
    expect(reasoningBlock!.textContent).toContain('思考中...');
  });

  it('工具消息不再显示 toolInfo 头部（toolName+toolCallId），仅渲染内容', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({
        id: 'm1',
        role: 'tool',
        content: '工具执行结果',
        sequenceNum: 1,
        toolInfo: { toolCallId: 'call-001', toolName: 'search' },
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('工具执行结果')).toBeTruthy();
    });
    expect(screen.queryByText('search')).toBeNull();
    expect(screen.queryByText('call-001')).toBeNull();
  });

  it('tool 消息带 toolResult 时按 AgentChat loadHistory 一致的 Markdown 结构渲染', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({
        id: 'm1',
        role: 'tool',
        content: '原始内容',
        sequenceNum: 1,
        toolInfo: { toolCallId: 'call-001', toolName: 'search' },
        toolResult: JSON.stringify({
          toolName: 'search',
          arguments: '{"keyword":"test"}',
          result: '找到 3 条结果',
        }),
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('工具: search')).toBeTruthy();
    });
    expect(screen.getByText('参数:')).toBeTruthy();
    expect(screen.getByText('执行结果:')).toBeTruthy();
    expect(screen.getByText('{"keyword":"test"}')).toBeTruthy();
    expect(screen.getByText('找到 3 条结果')).toBeTruthy();
  });

  it('tool 消息无 toolInfo 时 toolName 从 toolResult JSON 内兜底', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({
        id: 'm1',
        role: 'tool',
        content: '原始内容',
        sequenceNum: 1,
        toolResult: JSON.stringify({
          toolName: 'search',
          arguments: '{}',
          result: '完成',
        }),
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('工具: search')).toBeTruthy();
    });
    expect(screen.getByText('完成')).toBeTruthy();
  });

  it('tool 消息 toolResult 解析失败时保留原始 content', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({
        id: 'm1',
        role: 'tool',
        content: '原始内容',
        sequenceNum: 1,
        toolResult: 'not-json',
      }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('原始内容')).toBeTruthy();
    });
  });

  it('内容为空的助手消息不渲染气泡（移除"（空消息）"占位，仅保留角色头部）', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([
      makeMessage({ id: 'm1', role: 'assistant', content: '   ', sequenceNum: 1 }),
      makeMessage({ id: 'm2', role: 'user', content: '有内容', sequenceNum: 2 }),
    ]);
    renderComponent();

    await waitFor(() => {
      expect(screen.getByText('有内容')).toBeTruthy();
    });

    expect(screen.queryByText('（空消息）')).toBeNull();
    expect(screen.getAllByText('助手')).toHaveLength(1);
    const bubbles = Array.from(document.querySelectorAll('.agent-chat-markdown')).filter(
      (b) => (b.textContent ?? '').trim() !== '聚合文本内容',
    );
    expect(bubbles).toHaveLength(1);
    expect(bubbles[0].textContent).toContain('有内容');
  });

  it('返回按钮跳转 /memory/100/DAILY', async () => {
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByText('返回'));
    expect(mockNavigate).toHaveBeenCalledWith('/memory/100/DAILY');
  });

  it('GROUP 类型返回按钮跳转 /memory/100/GROUP', async () => {
    params = { sessionId: '100', type: 'GROUP', seqRange: '1-3' };
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByText('返回'));
    expect(mockNavigate).toHaveBeenCalledWith('/memory/100/GROUP');
  });
});

describe('MemoryDocumentDetail 配置弹窗', () => {
  beforeEach(() => {
    mocks.getSessionMessagesRange.mockReset();
    mocks.getMemoryPrompt.mockReset();
    mocks.saveMemoryPrompt.mockReset();
    mocks.updateMemoryDocument.mockReset();
    mocks.regenerateMemory.mockReset();
    mocks.getRegenerateStatus.mockReset();
    mocks.listModels.mockReset();
    mockNavigate.mockReset();
    params = { sessionId: '100', type: 'DAILY', seqRange: '1-3' };
    locationState = { startSeq: 1, endSeq: 3, aggregationText: '聚合文本内容' };
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
  });

  it('点击配置打开弹窗，加载已保存提示语（无模型下拉）', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('已保存提示语');
    mocks.listModels.mockResolvedValue([
      { id: 'm1', name: '模型A' },
      { id: 'm2', name: '模型B' },
    ]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /配\s*置/ }));
    await waitFor(() => {
      expect(mocks.getMemoryPrompt).toHaveBeenCalledWith('100');
    });
    expect(mocks.listModels).not.toHaveBeenCalled();
    expect(screen.getByText('提示语配置')).toBeTruthy();
    expect(screen.queryByText('模型（仅选择，不保存）')).toBeNull();
    expect((screen.getByDisplayValue('已保存提示语') as HTMLTextAreaElement).value).toBe(
      '已保存提示语',
    );
  });

  it('保存调用 saveMemoryPrompt 并提示成功关闭弹窗', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('旧提示语');
    mocks.listModels.mockResolvedValue([]);
    mocks.saveMemoryPrompt.mockResolvedValue(undefined);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /配\s*置/ }));
    const textarea = (await screen.findByDisplayValue('旧提示语')) as HTMLTextAreaElement;
    fireEvent.change(textarea, { target: { value: '新提示语' } });
    fireEvent.click(screen.getByRole('button', { name: /保\s*存/ }));

    await waitFor(() => {
      expect(mocks.saveMemoryPrompt).toHaveBeenCalledWith('100', '新提示语');
    });
  });

  it('保存失败时提示错误', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('p');
    mocks.listModels.mockResolvedValue([]);
    mocks.saveMemoryPrompt.mockRejectedValue(new Error('Network Error'));
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /配\s*置/ }));
    await screen.findByDisplayValue('p');
    fireEvent.click(screen.getByRole('button', { name: /保\s*存/ }));

    await waitFor(() => {
      expect(screen.getByText('保存提示语失败')).toBeTruthy();
    });
  });
});

describe('MemoryDocumentDetail 编辑弹窗', () => {
  beforeEach(() => {
    mocks.getSession.mockReset();
    mocks.getSessionMessagesRange.mockReset();
    mocks.getMemoryPrompt.mockReset();
    mocks.saveMemoryPrompt.mockReset();
    mocks.updateMemoryDocument.mockReset();
    mocks.regenerateMemory.mockReset();
    mocks.getRegenerateStatus.mockReset();
    mocks.listModels.mockReset();
    mockNavigate.mockReset();
    params = { sessionId: '100', type: 'DAILY', seqRange: '1-3' };
    locationState = { startSeq: 1, endSeq: 3, aggregationText: '聚合文本内容' };
    mocks.getSessionMessagesRange.mockResolvedValue([makeMessage()]);
    mocks.getSession.mockResolvedValue({
      id: '100',
      agentId: 'a1',
      modelId: 'm1',
      title: '会话A',
      createTime: '2026-08-01T00:00:00',
      updateTime: '2026-08-01T00:00:00',
    });
  });

  it('点击编辑打开弹窗：左侧加载已保存提示语，右侧显示聚合文本，含模型下拉', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('提示语X');
    mocks.listModels.mockResolvedValue([
      { id: 'm1', name: '模型A' },
      { id: 'm2', name: '模型B' },
    ]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await waitFor(() => {
      expect(mocks.getMemoryPrompt).toHaveBeenCalledWith('100');
      expect(mocks.listModels).toHaveBeenCalledWith({ modelType: 'LLM' });
      expect(mocks.getSession).toHaveBeenCalledWith('100');
    });
    expect(screen.getByText('编辑聚合文档')).toBeTruthy();
    expect(screen.getByText('模型（仅选择，不保存）')).toBeTruthy();
    expect((screen.getByDisplayValue('提示语X') as HTMLTextAreaElement).value).toBe('提示语X');
    const aggTextareas = screen.getAllByDisplayValue('聚合文本内容');
    expect(aggTextareas.length).toBeGreaterThanOrEqual(1);
    expect(
      aggTextareas.some((el) => (el as HTMLTextAreaElement).value === '聚合文本内容'),
    ).toBe(true);
  });

  it('模型列表加载完成后预选会话 modelId 对应模型', async () => {
    mocks.getSession.mockResolvedValue({
      id: '100',
      agentId: 'a1',
      modelId: 'm2',
      title: '会话A',
      createTime: '2026-08-01T00:00:00',
      updateTime: '2026-08-01T00:00:00',
    });
    mocks.listModels.mockResolvedValue([
      { id: 'm1', name: '模型A' },
      { id: 'm2', name: '模型B' },
    ]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await waitFor(() => {
      expect(mocks.getSession).toHaveBeenCalledWith('100');
    });
    await waitFor(() => {
      expect(screen.getByText('模型B')).toBeTruthy();
    });
    expect(screen.queryByText('选择模型')).toBeNull();
  });

  it('会话 modelId 不在模型列表时模型下拉保持未选中', async () => {
    mocks.getSession.mockResolvedValue({
      id: '100',
      agentId: 'a1',
      modelId: 'm99',
      title: '会话A',
      createTime: '2026-08-01T00:00:00',
      updateTime: '2026-08-01T00:00:00',
    });
    mocks.listModels.mockResolvedValue([{ id: 'm1', name: '模型A' }]);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await waitFor(() => {
      expect(mocks.listModels).toHaveBeenCalledWith({ modelType: 'LLM' });
    });
    expect(screen.getByText('选择模型')).toBeTruthy();
    expect(screen.queryByText('模型A')).toBeNull();
  });

  it('保存调用 updateMemoryDocument 并回调更新详情页聚合文本', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('p');
    mocks.updateMemoryDocument.mockResolvedValue(undefined);
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await screen.findByDisplayValue('p');
    fireEvent.change(screen.getByDisplayValue('聚合文本内容'), {
      target: { value: '新聚合文本' },
    });
    fireEvent.click(screen.getByRole('button', { name: /保\s*存/ }));

    await waitFor(() => {
      expect(mocks.updateMemoryDocument).toHaveBeenCalledWith(
        '100',
        '100_DAILY_1_3',
        '新聚合文本',
      );
    });
    await waitFor(() => {
      expect(screen.getByText('新聚合文本')).toBeTruthy();
    });
  });

  it('重新生成调用 regenerateMemory 并轮询 getRegenerateStatus，完成后回填新文本', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('p');
    mocks.regenerateMemory.mockResolvedValue({
      sessionId: '100',
      docId: '100_DAILY_1_3',
      status: 'RUNNING',
    });
    mocks.getRegenerateStatus.mockResolvedValue({
      sessionId: '100',
      docId: '100_DAILY_1_3',
      status: 'COMPLETED',
      aggregationText: '新生成的聚合文本',
    });
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await screen.findByDisplayValue('p');
    fireEvent.click(screen.getByText('重新生成'));

    await waitFor(() => {
      expect(mocks.regenerateMemory).toHaveBeenCalledWith('100', {
        docId: '100_DAILY_1_3',
        startSeq: 1,
        endSeq: 3,
        prompt: 'p',
      });
      expect(mocks.getRegenerateStatus).toHaveBeenCalledWith('100');
    });

    await waitFor(() => {
      expect(
        (screen.getByDisplayValue('新生成的聚合文本') as HTMLTextAreaElement).value,
      ).toBe('新生成的聚合文本');
    });
    await waitFor(() => {
      expect(screen.getByText('新生成的聚合文本')).toBeTruthy();
    });
  });

  it('重新生成 FAILED 时提示错误', async () => {
    mocks.getMemoryPrompt.mockResolvedValue('p');
    mocks.regenerateMemory.mockResolvedValue({
      sessionId: '100',
      docId: '100_DAILY_1_3',
      status: 'RUNNING',
    });
    mocks.getRegenerateStatus.mockResolvedValue({
      sessionId: '100',
      docId: '100_DAILY_1_3',
      status: 'FAILED',
      error: '生成失败',
    });
    renderComponent();
    await waitFor(() => {
      expect(mocks.getSessionMessagesRange).toHaveBeenCalled();
    });

    fireEvent.click(screen.getByRole('button', { name: /编\s*辑/ }));
    await screen.findByDisplayValue('p');
    fireEvent.click(screen.getByText('重新生成'));

    await waitFor(() => {
      expect(screen.getByText('生成失败')).toBeTruthy();
    });
  });
});

describe('MemoryDocumentDetail 源码配置', () => {
  it('调用 getSessionMessagesRange 接口并支持聚合文本状态管理', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('getSessionMessagesRange');
    expect(source).toContain('useState<string>(');
    expect(source).toContain('aggregationText');
    expect(source).toContain('setAggregationText');
  });

  it('左侧聚合文本以 Markdown 渲染展示（ReactMarkdown+remarkGfm，agent-chat-markdown）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('ReactMarkdown remarkPlugins={[remarkGfm]}');
    expect(source).toContain('agent-chat-markdown');
    expect(source).toContain('{aggregationText ?');
    expect(source).not.toContain('value={state.aggregationText');
  });

  it('编辑保存或重新生成成功后回调更新聚合文本状态', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('setAggregationText(editText)');
    expect(source).toContain('setAggregationText(status.aggregationText)');
  });

  it('消息以对话气泡样式渲染（ROLE_CONFIG/BUBBLE_STYLES + Markdown）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('ROLE_CONFIG');
    expect(source).toContain('BUBBLE_STYLES');
    expect(source).toContain('ReactMarkdown remarkPlugins={[remarkGfm]}');
    expect(source).toContain('agent-chat-markdown');
  });

  it('消息按 sequenceNum 升序排列', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('.sort((a, b) => a.sequenceNum - b.sequenceNum)');
  });

  it('左右两栏等高容器布局，各自内容区独立滚动', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain("alignItems: 'stretch'");
    expect(source).toContain("overflowY: 'auto'");
    expect(source).toContain('minHeight: 0');
  });

  it('助手消息 reasoning 渲染"思考过程"块（黄色左边框）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('思考过程');
    expect(source).toContain("borderLeft: '3px solid #ffd700'");
    expect(source).toContain('msg.reasoning && renderReasoning(msg.reasoning)');
  });

  it('工具消息不再渲染 toolInfo 头部（toolName+toolCallId）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).not.toContain("msg.toolInfo && msg.role === 'tool'");
    expect(source).not.toContain('msg.toolInfo.toolCallId');
    expect(source).toContain('msg.toolInfo?.toolName');
  });

  it('tool 消息带 toolResult 时格式化为 AgentChat loadHistory 一致结构（buildToolContent）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('buildToolContent(msg)');
    expect(source).toContain("msg.role === 'tool' && msg.toolResult");
    expect(source).toContain('msg.toolInfo?.toolName || tr.toolName');
    expect(source).toContain('**工具: ${toolName}**');
    expect(source).toContain('**参数:**');
    expect(source).toContain('**执行结果:**');
  });

  it('内容为空的助手消息不渲染气泡（移除"（空消息）"占位）', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).not.toContain('（空消息）');
    expect(source).toContain('{content && (');
  });

  it('messages/range URL 封装在 services/session.ts', () => {
    const serviceSource = readFileSync(resolve(__dirname, '../../../services/session.ts'), 'utf-8');
    expect(serviceSource).toContain('`/sessions/${sessionId}/messages/range`');
  });

  it('页面右下角提供配置/编辑按钮', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain("justifyContent: 'flex-end'");
    expect(source).toContain('openConfigModal()');
    expect(source).toContain('openEditModal()');
    expect(source).toContain('配置');
    expect(source).toContain('编辑');
  });

  it('配置弹窗仅保留提示语输入框（模型下拉已迁移到编辑弹窗），保存调用 saveMemoryPrompt', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('提示语配置');
    expect(source).toContain('saveMemoryPrompt(sessionId, configPrompt)');
    expect(source).toContain('getMemoryPrompt(sessionId)');
    expect(source).not.toContain('configModelId');
  });

  it('编辑弹窗打开时调用 getSession 获取会话 modelId，模型列表加载完成后预选该模型', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('getSession(sessionId)');
    expect(source).toContain('sessionModelId = session?.modelId');
    expect(source).toContain('models?.some((m) => m.id === sessionModelId)');
    expect(source).toContain('setEditModelId(sessionModelId)');
  });

  it('编辑弹窗左右输入框 + 模型下拉（从配置弹窗迁移），保存调用 updateMemoryDocument，重新生成调用 regenerateMemory 并轮询 status', () => {
    const source = readFileSync(resolve(__dirname, '../MemoryDocumentDetail.tsx'), 'utf-8');
    expect(source).toContain('编辑聚合文档');
    expect(source).toContain('editModelId');
    expect(source).toContain("listModels({ modelType: 'LLM' })");
    expect(source).toContain('updateMemoryDocument(sessionId, docId, editText)');
    expect(source).toContain('regenerateMemory(sessionId, {');
    expect(source).toContain('getRegenerateStatus(sessionId)');
    expect(source).toContain("status.status === 'COMPLETED'");
    expect(source).toContain('setEditText(status.aggregationText)');
  });

  it('memory 服务 URL 契约（memory-prompt/update/regenerate/regenerate-status）', () => {
    const serviceSource = readFileSync(resolve(__dirname, '../../../services/memory.ts'), 'utf-8');
    expect(serviceSource).toContain('`/sessions/${sessionId}/memory-prompt`');
    expect(serviceSource).toContain('`/sessions/${sessionId}/memory/update`');
    expect(serviceSource).toContain('`/sessions/${sessionId}/memory/regenerate`');
    expect(serviceSource).toContain('`/sessions/${sessionId}/memory/regenerate/status`');
  });
});
