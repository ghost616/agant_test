import { useCallback, useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { Button, message, Space, Table, Typography } from 'antd';
import type { ColumnsType } from 'antd/es/table';
import type { AgentConfig } from '../../types/agent';
import type { Session } from '../../types/session';
import { getSessionMessages, listSessions } from '../../services/session';
import { listAgents } from '../../services/agent';

interface MemorySession extends Session {
  agentName?: string;
  lastMessageTime?: string;
}

/**
 * 记忆回看会话列表页：展示已开启记忆功能的智能体会话，
 * 每条提供「按日聚合」与「按分类聚合」入口。
 */
function MemoryList(): JSX.Element {
  const navigate = useNavigate();
  const [dataSource, setDataSource] = useState<MemorySession[]>([]);
  const [loading, setLoading] = useState(false);

  const fetchList = useCallback(async (): Promise<void> => {
    setLoading(true);
    try {
      const [sessions, agents] = await Promise.all([listSessions(), listAgents()]);
      const agentMap: Record<string, AgentConfig> = {};
      agents.forEach((agent) => {
        agentMap[agent.id] = agent;
      });

      const memorySessions = sessions.filter(
        (session) => agentMap[session.agentId]?.memoryEnabled === true,
      );

      const rows = await Promise.all(
        memorySessions.map(async (session): Promise<MemorySession> => {
          let lastMessageTime: string | undefined;
          try {
            const messages = await getSessionMessages(session.id);
            const last = messages[messages.length - 1];
            lastMessageTime = last?.createTime;
          } catch {
            lastMessageTime = undefined;
          }
          return {
            ...session,
            agentName: agentMap[session.agentId]?.name,
            lastMessageTime,
          };
        }),
      );
      setDataSource(rows);
    } catch {
      message.error('获取会话列表失败');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchList();
  }, [fetchList]);

  const columns: ColumnsType<MemorySession> = [
    {
      title: '会话名称',
      dataIndex: 'title',
      width: 220,
      ellipsis: true,
      render: (value?: string) => value || '未命名会话',
    },
    {
      title: '智能体名',
      dataIndex: 'agentName',
      width: 180,
      ellipsis: true,
      render: (value?: string) => value || '-',
    },
    {
      title: '最近消息时间',
      dataIndex: 'lastMessageTime',
      width: 180,
      render: (value?: string) => value || '-',
    },
    {
      title: '操作',
      key: 'actions',
      width: 220,
      render: (_: unknown, record: MemorySession) => (
        <Space size="small">
          <Button
            type="link"
            size="small"
            onClick={() => navigate(`/memory/${record.id}/DAILY`)}
          >
            按日聚合
          </Button>
          <Button
            type="link"
            size="small"
            onClick={() => navigate(`/memory/${record.id}/GROUP`)}
          >
            按分类聚合
          </Button>
        </Space>
      ),
    },
  ];

  return (
    <div>
      <Typography.Title level={5} style={{ marginBottom: 16 }}>
        记忆回看
      </Typography.Title>
      <Table<MemorySession>
        rowKey="id"
        columns={columns}
        dataSource={dataSource}
        loading={loading}
        pagination={false}
        scroll={{ x: 800 }}
      />
    </div>
  );
}

export default MemoryList;
