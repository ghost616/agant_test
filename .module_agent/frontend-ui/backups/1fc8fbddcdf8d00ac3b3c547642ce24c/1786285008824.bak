import { describe, it, expect, vi, beforeEach, beforeAll } from 'vitest';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import type { AgentLog } from '../../../types/log';

const mocks = vi.hoisted(() => ({
  listAgentLogs: vi.fn(),
}));

vi.mock('../../../services/log', () => ({
  listAgentLogs: (...args: unknown[]) => mocks.listAgentLogs(...args),
}));

import AgentLogList from '../AgentLogList';

beforeAll(() => {
  window.matchMedia =
    window.matchMedia ||
    ((query: string) => ({
      matches: false,
      media: query,
      onchange: null,
      addListener: vi.fn(),
      removeListener: vi.fn(),
      addEventListener: vi.fn(),
      removeEventListener: vi.fn(),
      dispatchEvent: vi.fn(),
    }));
});

function makeLog(overrides: Partial<AgentLog> = {}): AgentLog {
  return {
    id: '1',
    sessionId: '100',
    sessionName: '会话A',
    conversationId: 'conv-1',
    logType: 'ROUTE',
    logLevel: 'INFO',
    logData: '{"a":1}',
    createTime: '2026-08-09 10:00:00',
    ...overrides,
  };
}

function renderComponent() {
  return render(<AgentLogList />);
}

function defaultMockResult(overrides: Partial<AgentLog> = {}) {
  return { list: [makeLog(overrides)], total: 1, page: 1, size: 20 };
}

describe('AgentLogList 初始加载与表格渲染', () => {
  beforeEach(() => {
    mocks.listAgentLogs.mockReset();
    mocks.listAgentLogs.mockResolvedValue(defaultMockResult());
  });

  it('初始加载调用 listAgentLogs（page=1, size=20，无筛选）', async () => {
    renderComponent();

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(1);
    });
    expect(mocks.listAgentLogs).toHaveBeenCalledWith({
      sessionName: undefined,
      logType: undefined,
      logLevel: undefined,
      page: 1,
      size: 20,
    });
  });

  it('渲染表格列（会话名/对话ID/日志类型/日志等级/日志数据/会话变量/对话变量/创建时间）', async () => {
    renderComponent();
    await waitFor(() => {
      expect(screen.getAllByText('会话A').length).toBeGreaterThan(0);
    });

    const headerTexts = Array.from(
      document.querySelectorAll('.ant-table-thead th'),
    ).map((el) => el?.textContent ?? '');
    for (const title of [
      '会话名',
      '对话ID',
      '日志类型',
      '日志等级',
      '日志数据',
      '会话变量',
      '对话变量',
      '创建时间',
    ]) {
      expect(headerTexts).toContain(title);
    }
    expect(screen.getAllByText('conv-1').length).toBeGreaterThan(0);
  });

  it('日志类型列显示中文标签 Tag，日志等级列显示彩色 Badge', async () => {
    renderComponent();

    const tag = await screen.findByText('路由分发');
    expect(tag.closest('.ant-tag')).toBeTruthy();
    const badge = screen.getByText('信息');
    expect(badge.closest('.ant-badge')).toBeTruthy();
  });
});

describe('AgentLogList 日志数据展开', () => {
  beforeEach(() => {
    mocks.listAgentLogs.mockReset();
  });

  it('日志数据超长时显示省略与展开按钮，点击弹出详情 Modal', async () => {
    const longData = JSON.stringify({ message: '很长的日志内容'.repeat(20) });
    mocks.listAgentLogs.mockResolvedValue(defaultMockResult({ logData: longData }));

    renderComponent();

    const expandBtn = await screen.findByRole('button', { name: '展开' });
    expect(expandBtn).toBeTruthy();
    expect(screen.queryByRole('button', { name: '展开' })).toBeTruthy();

    fireEvent.click(expandBtn);

    await waitFor(() => {
      expect(screen.getByText('日志详情')).toBeTruthy();
    });
    expect(document.body.textContent).toContain('很长的日志内容');
  });

  it('日志数据较短时不显示展开按钮', async () => {
    mocks.listAgentLogs.mockResolvedValue(defaultMockResult({ logData: '{"a":1}' }));

    renderComponent();
    await screen.findByText('会话A');

    expect(screen.queryByRole('button', { name: '展开' })).toBeNull();
  });

  it('Modal 关闭后再次打开仍正常展示完整数据（destroyOnHidden）', async () => {
    const longData = JSON.stringify({ message: '非常长的日志内容'.repeat(20) });
    mocks.listAgentLogs.mockResolvedValue(defaultMockResult({ logData: longData }));

    renderComponent();
    const expandBtn = await screen.findByRole('button', { name: '展开' });

    fireEvent.click(expandBtn);
    await waitFor(() => {
      expect(screen.getByText('日志详情')).toBeTruthy();
    });
    expect(document.body.textContent).toContain('非常长的日志内容');

    const closeBtn = document.querySelector(
      '.ant-modal-footer .ant-btn',
    ) as HTMLElement;
    expect(closeBtn).toBeTruthy();
    fireEvent.click(closeBtn);

    const expandBtnAgain = await screen.findByRole('button', { name: '展开' });
    fireEvent.click(expandBtnAgain);
    await waitFor(() => {
      expect(document.querySelector('.ant-modal-footer .ant-btn')).toBeTruthy();
    });
    expect(document.body.textContent).toContain('非常长的日志内容');
  });
});

describe('AgentLogList 会话变量与对话变量列', () => {
  beforeEach(() => {
    mocks.listAgentLogs.mockReset();
  });

  it('会话变量为空时显示占位符 -', async () => {
    mocks.listAgentLogs.mockResolvedValue(defaultMockResult());

    renderComponent();
    await screen.findByText('会话A');

    const dashCells = Array.from(document.querySelectorAll('.ant-table-tbody td')).filter(
      (el) => el?.textContent?.trim() === '-',
    );
    expect(dashCells.length).toBeGreaterThanOrEqual(2);
  });

  it('会话变量/对话变量超长时显示省略与展开按钮，点击弹出变量详情 Modal', async () => {
    const longVars = JSON.stringify({ key: '很长的变量内容'.repeat(20) });
    mocks.listAgentLogs.mockResolvedValue(
      defaultMockResult({ sessionVariables: longVars, conversationVariables: longVars }),
    );

    renderComponent();

    const expandBtns = await screen.findAllByRole('button', { name: '展开' });
    expect(expandBtns).toHaveLength(2);

    fireEvent.click(expandBtns[0]);

    await waitFor(() => {
      expect(screen.getByText('会话变量详情')).toBeTruthy();
    });
    expect(document.body.textContent).toContain('很长的变量内容');
  });

  it('变量详情 Modal 关闭后重新打开对话变量仍正常（destroyOnHidden）', async () => {
    const longVars = JSON.stringify({ key: '另一个很长的变量内容'.repeat(20) });
    mocks.listAgentLogs.mockResolvedValue(
      defaultMockResult({ sessionVariables: longVars, conversationVariables: longVars }),
    );

    renderComponent();
    const expandBtns = await screen.findAllByRole('button', { name: '展开' });

    fireEvent.click(expandBtns[0]);
    await waitFor(() => {
      expect(screen.getByText('会话变量详情')).toBeTruthy();
    });
    const closeBtn = document.querySelector(
      '.ant-modal-footer .ant-btn',
    ) as HTMLElement;
    fireEvent.click(closeBtn);

    const expandBtnsAgain = await screen.findAllByRole('button', { name: '展开' });
    fireEvent.click(expandBtnsAgain[1]);
    await waitFor(() => {
      expect(screen.getByText('对话变量详情')).toBeTruthy();
    });
    expect(document.body.textContent).toContain('另一个很长的变量内容');
  });

  it('变量内容较短时不显示展开按钮', async () => {
    mocks.listAgentLogs.mockResolvedValue(
      defaultMockResult({ sessionVariables: '{"a":1}', conversationVariables: '{}' }),
    );

    renderComponent();
    await screen.findByText('会话A');

    expect(screen.queryByRole('button', { name: '展开' })).toBeNull();
  });
});

describe('AgentLogList 筛选与分页', () => {
  beforeEach(() => {
    mocks.listAgentLogs.mockReset();
    mocks.listAgentLogs.mockResolvedValue({
      list: [makeLog()],
      total: 100,
      page: 1,
      size: 20,
    });
  });

  it('日志类型筛选变更后重新请求并重置到第 1 页', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const placeholder = screen.getByText('日志类型', {
      selector: '.ant-select-selection-placeholder',
    });
    fireEvent.mouseDown(placeholder);
    const option = await screen.findByText('模型调用', {
      selector: '.ant-select-item-option-content',
    });
    fireEvent.click(option);

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(2);
    });
    const lastCall = mocks.listAgentLogs.mock.calls[1][0] as {
      logType: string;
      page: number;
    };
    expect(lastCall.logType).toBe('MODEL_CALL');
    expect(lastCall.page).toBe(1);
  });

  it('会话名搜索后重新请求并重置到第 1 页', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const input = document.querySelector('.ant-input') as HTMLInputElement;
    fireEvent.change(input, { target: { value: '会话B' } });
    fireEvent.keyDown(input, { key: 'Enter', code: 'Enter', keyCode: 13 });

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(2);
    });
    const lastCall = mocks.listAgentLogs.mock.calls[1][0] as {
      sessionName: string;
      page: number;
    };
    expect(lastCall.sessionName).toBe('会话B');
    expect(lastCall.page).toBe(1);
  });

  it('切换页码后重新请求携带新页码', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const page2 = document.querySelector('.ant-pagination-item-2') as HTMLElement;
    expect(page2).toBeTruthy();
    fireEvent.click(page2);

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(2);
    });
    const lastCall = mocks.listAgentLogs.mock.calls[1][0] as {
      page: number;
      size: number;
    };
    expect(lastCall.page).toBe(2);
    expect(lastCall.size).toBe(20);
  });

  it('pageSizeOptions 为 20/50/100 并启用每页条数切换', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const sizeChanger = document.querySelector(
      '.ant-pagination-options .ant-select .ant-select-selector',
    ) as HTMLElement;
    expect(sizeChanger).toBeTruthy();
    fireEvent.mouseDown(sizeChanger);
    await waitFor(() => {
      const options = Array.from(
        document.querySelectorAll('.ant-select-item-option-content'),
      ).map((el) => el?.textContent?.trim() ?? '');
      expect(options.some((t) => t.includes('20'))).toBe(true);
      expect(options.some((t) => t.includes('50'))).toBe(true);
      expect(options.some((t) => t.includes('100'))).toBe(true);
    });
  });

  it('切换每页条数后重新请求携带新 size 并重置到第 1 页', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const sizeChanger = document.querySelector(
      '.ant-pagination-options .ant-select .ant-select-selector',
    ) as HTMLElement;
    fireEvent.mouseDown(sizeChanger);
    const option50 = await screen.findByText(/50/, {
      selector: '.ant-select-item-option-content',
    });
    fireEvent.click(option50);

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(2);
    });
    const lastCall = mocks.listAgentLogs.mock.calls[1][0] as {
      page: number;
      size: number;
    };
    expect(lastCall.size).toBe(50);
    expect(lastCall.page).toBe(1);
  });

  it('切换到第 2 页后再切换每页条数，请求 page=1 且 size 为新值', async () => {
    renderComponent();
    await screen.findByText('会话A');

    const page2 = document.querySelector('.ant-pagination-item-2') as HTMLElement;
    fireEvent.click(page2);
    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(2);
    });
    const page2Call = mocks.listAgentLogs.mock.calls[1][0] as {
      page: number;
      size: number;
    };
    expect(page2Call.page).toBe(2);
    expect(page2Call.size).toBe(20);

    const sizeChanger = document.querySelector(
      '.ant-pagination-options .ant-select .ant-select-selector',
    ) as HTMLElement;
    fireEvent.mouseDown(sizeChanger);
    const option100 = await screen.findByText(/100/, {
      selector: '.ant-select-item-option-content',
    });
    fireEvent.click(option100);

    await waitFor(() => {
      expect(mocks.listAgentLogs).toHaveBeenCalledTimes(3);
    });
    const lastCall = mocks.listAgentLogs.mock.calls[2][0] as {
      page: number;
      size: number;
    };
    expect(lastCall.page).toBe(1);
    expect(lastCall.size).toBe(100);
  });
});
