import { useCallback, useEffect, useMemo, useState } from 'react';
import type { CSSProperties } from 'react';
import { useLocation, useNavigate, useParams } from 'react-router-dom';
import { Button, Input, message, Modal, Select, Space, Spin, Typography } from 'antd';
import {
  ArrowLeftOutlined,
  InfoCircleOutlined,
  RobotOutlined,
  ToolOutlined,
  UserOutlined,
} from '@ant-design/icons';
import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import type { SessionMessage } from '../../types/session';
import type { ModelConfig } from '../../types/model';
import type { MemoryAggregationType } from '../../types/memory';
import { getSession, getSessionMessagesRange } from '../../services/session';
import { listModels } from '../../services/model';
import {
  getMemoryPrompt,
  getRegenerateStatus,
  regenerateMemory,
  saveMemoryPrompt,
  updateMemoryDocument,
} from '../../services/memory';

const REGENERATE_POLL_INTERVAL = 2000;
const REGENERATE_MAX_ATTEMPTS = 30;

type MessageRole = 'user' | 'assistant' | 'tool' | 'system';

const ROLES: MessageRole[] = ['user', 'assistant', 'tool', 'system'];

const ROLE_CONFIG: Record<MessageRole, { label: string; icon: JSX.Element; color: string }> = {
  user: { label: '你', icon: <UserOutlined />, color: '#569cd6' },
  assistant: { label: '助手', icon: <RobotOutlined />, color: '#4ec9b0' },
  tool: { label: '工具', icon: <ToolOutlined />, color: '#d7ba7d' },
  system: { label: '系统', icon: <InfoCircleOutlined />, color: '#9cdcfe' },
};

const BUBBLE_STYLES: Record<MessageRole, CSSProperties> = {
  user: {
    background: '#1a3a5c',
    borderRadius: 12,
    padding: '10px 14px',
  },
  assistant: {
    background: '#2a2a2a',
    borderRadius: 12,
    padding: '10px 14px',
  },
  tool: {
    background: '#3a3a3a',
    borderRadius: 12,
    padding: '10px 14px',
  },
  system: {
    background: '#2d3748',
    borderRadius: 12,
    padding: '10px 14px',
  },
};

const DETAIL_LAYOUT_STYLE: CSSProperties = {
  display: 'flex',
  gap: 16,
  alignItems: 'stretch',
  height: 520,
};

const TEXT_PANE_STYLE: CSSProperties = {
  width: 380,
  flexShrink: 0,
  display: 'flex',
  flexDirection: 'column',
};

const LIST_PANE_STYLE: CSSProperties = {
  flex: 1,
  minWidth: 0,
  display: 'flex',
  flexDirection: 'column',
};

const MESSAGE_AREA_STYLE: CSSProperties = {
  flex: 1,
  minHeight: 0,
  marginTop: 8,
  overflowY: 'auto',
  background: '#1a1a1a',
  borderRadius: 8,
  padding: 16,
};

/**
 * 与 AgentChat loadHistory 对齐：tool 消息且 toolResult 非空时解析 JSON，
 * 格式化为"**工具: toolName**\n\n**参数:**\n```json\narguments\n```\n\n**执行结果:**\nresult"，
 * toolName 取 toolInfo.toolName 或 JSON 内 toolName 兜底；解析失败保持原始内容。
 */
function buildToolContent(msg: SessionMessage): string {
  if (msg.role === 'tool' && msg.toolResult) {
    try {
      const tr = JSON.parse(msg.toolResult) as {
        toolName?: string;
        arguments?: string;
        result?: string;
      };
      const toolName = msg.toolInfo?.toolName || tr.toolName;
      return `**工具: ${toolName}**\n\n**参数:**\n\`\`\`json\n${tr.arguments}\n\`\`\`\n\n**执行结果:**\n${tr.result}`;
    } catch {
      // keep original content
    }
  }
  return msg.content;
}

/**
 * 记忆聚合文档详情页：左侧只读展示聚合文本，
 * 右侧按序列号区间展示生成该聚合文本的全部消息（对话气泡样式，Markdown 渲染）。
 */
function MemoryDocumentDetail(): JSX.Element {
  const { sessionId = '', type = 'DAILY', seqRange = '' } = useParams<{
    sessionId?: string;
    type?: string;
    seqRange?: string;
  }>();
  const location = useLocation();
  const navigate = useNavigate();

  const state = (location.state ?? {}) as {
    startSeq?: number;
    endSeq?: number;
    aggregationText?: string;
  };

  const parsed = seqRange.split('-');
  const startSeq: number = state.startSeq ?? Number(parsed[0]);
  const endSeq: number = state.endSeq ?? Number(parsed[1]);

  const [messages, setMessages] = useState<SessionMessage[]>([]);
  const [loading, setLoading] = useState(false);

  const [configVisible, setConfigVisible] = useState(false);
  const [configPrompt, setConfigPrompt] = useState('');
  const [configSaving, setConfigSaving] = useState(false);
  const [modelList, setModelList] = useState<ModelConfig[]>([]);

  const [editVisible, setEditVisible] = useState(false);
  const [editPrompt, setEditPrompt] = useState('');
  const [editText, setEditText] = useState('');
  const [editModelId, setEditModelId] = useState<string | undefined>(undefined);
  const [editSaving, setEditSaving] = useState(false);
  const [regenerating, setRegenerating] = useState(false);

  const aggType: MemoryAggregationType = type === 'GROUP' ? 'GROUP' : 'DAILY';
  const docId = `${sessionId}_${aggType}_${startSeq}_${endSeq}`;

  const fetchMessages = useCallback(async (): Promise<void> => {
    if (!Number.isInteger(startSeq) || !Number.isInteger(endSeq)) {
      return;
    }
    setLoading(true);
    try {
      const result = await getSessionMessagesRange(sessionId, startSeq, endSeq);
      setMessages(result);
    } catch {
      message.error('获取消息列表失败');
      setMessages([]);
    } finally {
      setLoading(false);
    }
  }, [sessionId, startSeq, endSeq]);

  useEffect(() => {
    fetchMessages();
  }, [fetchMessages]);

  const openConfigModal = useCallback(async (): Promise<void> => {
    setConfigVisible(true);
    try {
      const prompt = await getMemoryPrompt(sessionId);
      setConfigPrompt(prompt ?? '');
    } catch {
      setConfigPrompt('');
    }
  }, [sessionId]);

  const handleConfigSave = useCallback(async (): Promise<void> => {
    setConfigSaving(true);
    try {
      await saveMemoryPrompt(sessionId, configPrompt);
      message.success('提示语已保存');
      setConfigVisible(false);
    } catch {
      message.error('保存提示语失败');
    } finally {
      setConfigSaving(false);
    }
  }, [sessionId, configPrompt]);

  const openEditModal = useCallback(async (): Promise<void> => {
    setEditVisible(true);
    setEditText(state.aggregationText ?? '');
    try {
      const prompt = await getMemoryPrompt(sessionId);
      setEditPrompt(prompt ?? '');
    } catch {
      setEditPrompt('');
    }
    let sessionModelId: string | undefined;
    try {
      const session = await getSession(sessionId);
      sessionModelId = session?.modelId;
    } catch {
      sessionModelId = undefined;
    }
    try {
      const models = await listModels({ modelType: 'LLM' });
      setModelList(models ?? []);
      if (sessionModelId && models?.some((m) => m.id === sessionModelId)) {
        setEditModelId(sessionModelId);
      } else {
        setEditModelId(undefined);
      }
    } catch {
      setModelList([]);
      setEditModelId(undefined);
    }
  }, [sessionId, state.aggregationText]);

  const handleEditSave = useCallback(async (): Promise<void> => {
    setEditSaving(true);
    try {
      await updateMemoryDocument(sessionId, docId, editText);
      message.success('聚合文本已保存');
      setEditVisible(false);
    } catch {
      message.error('保存聚合文本失败');
    } finally {
      setEditSaving(false);
    }
  }, [sessionId, docId, editText]);

  const handleRegenerate = useCallback(async (): Promise<void> => {
    setRegenerating(true);
    try {
      await regenerateMemory(sessionId, {
        docId,
        startSeq,
        endSeq,
        prompt: editPrompt,
      });
    } catch {
      message.error('触发重生成失败');
      setRegenerating(false);
      return;
    }
    let attempts = 0;
    const poll = async (): Promise<void> => {
      attempts += 1;
      if (attempts > REGENERATE_MAX_ATTEMPTS) {
        message.error('重新生成超时');
        setRegenerating(false);
        return;
      }
      try {
        const status = await getRegenerateStatus(sessionId);
        if (status.status === 'COMPLETED') {
          if (status.aggregationText != null) {
            setEditText(status.aggregationText);
          }
          message.success('聚合文本已重新生成');
          setRegenerating(false);
          return;
        }
        if (status.status === 'FAILED') {
          message.error(status.error || '重新生成失败');
          setRegenerating(false);
          return;
        }
        window.setTimeout(poll, REGENERATE_POLL_INTERVAL);
      } catch {
        message.error('查询重生成状态失败');
        setRegenerating(false);
      }
    };
    poll();
  }, [sessionId, docId, startSeq, endSeq, editPrompt]);

  const sortedMessages = useMemo(
    () => [...messages].sort((a, b) => a.sequenceNum - b.sequenceNum),
    [messages],
  );

  const renderRoleHeader = (role: MessageRole): JSX.Element => {
    const config = ROLE_CONFIG[role];
    return (
      <div style={{ display: 'flex', alignItems: 'center', gap: 4, marginBottom: 4 }}>
        <span style={{ color: config.color, fontSize: 14 }}>{config.icon}</span>
        <Typography.Text strong style={{ color: config.color, fontSize: 12 }}>
          {config.label}
        </Typography.Text>
      </div>
    );
  };

  const renderReasoning = (reasoning: string): JSX.Element => (
    <div
      style={{
        background: '#252525',
        borderLeft: '3px solid #ffd700',
        borderRadius: 4,
        padding: '8px 12px',
        marginBottom: 8,
      }}
      className="agent-chat-markdown"
    >
      <Typography.Text
        style={{ color: '#ffd700', fontSize: 12, marginBottom: 4, display: 'block' }}
      >
        思考过程
      </Typography.Text>
      <div style={{ color: '#aaa', fontSize: 13, lineHeight: 1.7 }}>
        <ReactMarkdown remarkPlugins={[remarkGfm]}>{reasoning}</ReactMarkdown>
      </div>
    </div>
  );

  const renderMessage = (msg: SessionMessage, idx: number): JSX.Element => {
    const role: MessageRole = ROLES.includes(msg.role as MessageRole)
      ? (msg.role as MessageRole)
      : 'system';
    const isUser = msg.role === 'user';
    const content = buildToolContent(msg).trim();
    return (
      <div
        key={idx}
        style={{
          display: 'flex',
          justifyContent: isUser ? 'flex-end' : 'flex-start',
          marginBottom: 16,
        }}
      >
        <div style={{ maxWidth: '80%' }}>
          {renderRoleHeader(role)}
          {msg.reasoning && renderReasoning(msg.reasoning)}
          {content && (
            <div style={BUBBLE_STYLES[role]} className="agent-chat-markdown">
              <div style={{ color: '#d4d4d4', fontSize: 14, lineHeight: 1.8 }}>
                <ReactMarkdown remarkPlugins={[remarkGfm]}>{content}</ReactMarkdown>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  };

  const backType: string = type === 'GROUP' ? 'GROUP' : 'DAILY';

  return (
    <div>
      <style>{`
        .agent-chat-markdown pre {
          background: #2d2d2d;
          border-radius: 6px;
          padding: 12px 16px;
          overflow-x: auto;
        }
        .agent-chat-markdown code {
          font-family: 'Consolas', 'Courier New', monospace;
          font-size: 13px;
        }
        .agent-chat-markdown :not(pre) > code {
          background: #2d2d2d;
          padding: 2px 6px;
          border-radius: 4px;
        }
        .agent-chat-markdown table {
          border-collapse: collapse;
          width: 100%;
          margin: 12px 0;
        }
        .agent-chat-markdown th,
        .agent-chat-markdown td {
          border: 1px solid #444;
          padding: 8px 12px;
          text-align: left;
        }
        .agent-chat-markdown th {
          background: #2d2d2d;
          font-weight: 600;
        }
        .agent-chat-markdown blockquote {
          border-left: 3px solid #555;
          padding-left: 12px;
          margin: 12px 0;
          color: #aaa;
        }
        .agent-chat-markdown a {
          color: #569cd6;
        }
        .agent-chat-markdown ul,
        .agent-chat-markdown ol {
          padding-left: 24px;
        }
        .agent-chat-markdown p {
          margin: 8px 0;
        }
      `}</style>
      <Space style={{ marginBottom: 16 }}>
        <Button
          icon={<ArrowLeftOutlined />}
          onClick={() => navigate(`/memory/${sessionId}/${backType}`)}
        >
          返回
        </Button>
        <Typography.Title level={5} style={{ margin: 0 }}>
          聚合文档详情
        </Typography.Title>
      </Space>
      <div style={DETAIL_LAYOUT_STYLE}>
        <div style={TEXT_PANE_STYLE}>
          <Typography.Text strong>聚合文本</Typography.Text>
          <Input.TextArea
            value={state.aggregationText ?? ''}
            readOnly
            style={{ flex: 1, minHeight: 0, marginTop: 8, resize: 'none' }}
          />
        </div>
        <div style={LIST_PANE_STYLE}>
          <Typography.Text strong>生成该聚合文本的消息</Typography.Text>
          <div style={MESSAGE_AREA_STYLE}>
            {loading ? (
              <div style={{ textAlign: 'center', padding: 40 }}>
                <Spin />
              </div>
            ) : sortedMessages.length === 0 ? (
              <Typography.Text style={{ color: '#666' }}>暂无消息</Typography.Text>
            ) : (
              sortedMessages.map(renderMessage)
            )}
          </div>
        </div>
      </div>
      <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 16 }}>
        <Button onClick={() => openConfigModal()}>配置</Button>
        <Button type="primary" onClick={() => openEditModal()}>
          编辑
        </Button>
      </div>

      <Modal
        title="提示语配置"
        open={configVisible}
        onCancel={() => setConfigVisible(false)}
        onOk={handleConfigSave}
        okText="保存"
        cancelText="关闭"
        confirmLoading={configSaving}
      >
        <div style={{ marginBottom: 16 }}>
          <Typography.Text strong>提示语</Typography.Text>
          <Input.TextArea
            value={configPrompt}
            onChange={(e) => setConfigPrompt(e.target.value)}
            rows={4}
            style={{ marginTop: 8 }}
          />
        </div>
      </Modal>

      <Modal
        title="编辑聚合文档"
        open={editVisible}
        onCancel={() => setEditVisible(false)}
        footer={[
          <Button key="cancel" onClick={() => setEditVisible(false)}>
            取消
          </Button>,
          <Button
            key="save"
            type="primary"
            loading={editSaving}
            onClick={handleEditSave}
          >
            保存
          </Button>,
          <Button
            key="regenerate"
            loading={regenerating}
            onClick={handleRegenerate}
          >
            重新生成
          </Button>,
        ]}
        width={900}
      >
        <div
          style={{
            display: 'flex',
            gap: 16,
            alignItems: 'stretch',
          }}
        >
          <div style={{ flex: 1, minWidth: 0 }}>
            <Typography.Text strong>提示语</Typography.Text>
            <Input.TextArea
              value={editPrompt}
              onChange={(e) => setEditPrompt(e.target.value)}
              rows={12}
              style={{ marginTop: 8 }}
            />
          </div>
          <div style={{ flex: 1, minWidth: 0 }}>
            <Typography.Text strong>聚合文本</Typography.Text>
            <Input.TextArea
              value={editText}
              onChange={(e) => setEditText(e.target.value)}
              rows={12}
              style={{ marginTop: 8 }}
            />
          </div>
        </div>
        <div style={{ marginTop: 16 }}>
          <Typography.Text strong>模型（仅选择，不保存）</Typography.Text>
          <Select
            style={{ width: '100%', marginTop: 8 }}
            placeholder="选择模型"
            value={editModelId}
            onChange={setEditModelId}
            options={modelList.map((m) => ({ label: m.name, value: m.id }))}
          />
        </div>
      </Modal>
    </div>
  );
}

export default MemoryDocumentDetail;
