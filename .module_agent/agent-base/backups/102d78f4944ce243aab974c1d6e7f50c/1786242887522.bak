package com.ghost616.agentbase.enums;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class LogNameTest {

    @Test
    void 空枚举应可被加载() {
        assertNotNull(LogName.class);
    }

    @Test
    void 枚举值数量应为0() {
        assertEquals(0, LogName.values().length);
    }
}
