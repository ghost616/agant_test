package com.ghost616.agentbase.service.agent.log;

import com.ghost616.agentbase.enums.LogType;
import lombok.Getter;
import lombok.experimental.SuperBuilder;

/**
 * 智能体消息处理日志数据，记录外部消息处理操作的类型与会话信息。
 */
@Getter
@SuperBuilder
public class HandleMessageLogData extends ContextLogData {

    /** 会话 ID */
    private final String sessionId;

    /** 消息类型：CHILD_CREATE_SESSION/HISTORY_MESSAGE/VARIABLE_MESSAGE/CONVERSATION_ID */
    private final String messageType;

    @Override
    public LogType logType() {
        return LogType.HANDLE_MESSAGE;
    }
}
